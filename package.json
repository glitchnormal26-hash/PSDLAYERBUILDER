{
  "name": "psdlayerbuilder",
  "version": "1.4.0",
  "private": true,
  "description": "Production-grade manifest-driven engine for generating and modifying editable layered Photoshop PSD mockups.",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "psdlayer": "dist/cli.js",
    "psdlayer-rebuild": "dist/rebuild-cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:uxp": "node --check uxp-finalizer/main.js",
    "magnific:rebuild": "node dist/rebuild-cli.js",
    "example:assets": "node scripts/generate-example-assets.mjs",
    "example": "npm run example:assets && npm run build && node dist/cli.js build examples/basic.mockup.json -o examples/output/basic-mockup.psd"
  },
  "dependencies": {
    "ag-psd": "31.0.2",
    "commander": "^14.0.3",
    "sharp": "^0.35.4",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
